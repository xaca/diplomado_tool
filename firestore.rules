rules_version = '2';

// Security Rules are the backend (PLAN.md → "Security Rules").
// Deny by default: every collection must be listed explicitly.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------

    function signedIn() {
      return request.auth != null;
    }

    function verified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    function staffPath(email) {
      return /databases/$(database)/documents/staffEmails/$(email);
    }

    function isTeacher() {
      return verified() && exists(staffPath(myEmail()));
    }

    function isAdmin() {
      return isTeacher() && get(staffPath(myEmail())).data.role == 'admin';
    }

    function boardPath(boardId) {
      return /databases/$(database)/documents/boards/$(boardId);
    }

    function memberPath(boardId, uid) {
      return /databases/$(database)/documents/boards/$(boardId)/members/$(uid);
    }

    function studentPath(boardId, studentId) {
      return /databases/$(database)/documents/boards/$(boardId)/students/$(studentId);
    }

    function studentEmailPath(boardId, email) {
      return /databases/$(database)/documents/boards/$(boardId)/studentEmails/$(email);
    }

    function isBoardTeacher(boardId) {
      return verified() && myEmail() in get(boardPath(boardId)).data.teacherEmails;
    }

    function isMember(boardId) {
      return signedIn() && exists(memberPath(boardId, request.auth.uid));
    }

    function isString(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }

    // Images shown to other people (profile photos): https only, bounded size
    function isHttpsUrl(value) {
      return isString(value, 9, 2000) && value.matches('https://.+');
    }

    function validEmails(emails) {
      return emails is list && emails.size() >= 1 && emails.size() <= 5;
    }

    // ---------- users/{uid}: login account profile ----------

    // Uploaded profile photo (M11): one fixed Cloudinary file per person (see media-api avatarParams)
    function validAvatar(avatar, uid) {
      return avatar == null
        || (avatar is map
          && avatar.keys().hasOnly(['publicId', 'version'])
          && avatar.publicId is string && avatar.publicId.matches('pbl/(dev|prod)/users/' + uid + '/avatar')
          && avatar.version is int);
    }

    // M21: a short profile message (no links) and card decorations; keep in sync with
    // statusSchema / decorSchema in src/model/index.ts
    function validStatus(status) {
      return status == null
        || (status is map
          && status.keys().hasOnly(['emoji', 'text'])
          && isString(status.emoji, 0, 16)
          && isString(status.text, 1, 60)
          && !status.text.lower().matches('.*(https?://|www[.]).*'));
    }

    function validDecor(decor) {
      return decor == null
        || (decor is map
          && decor.keys().hasOnly(['banner', 'sticker'])
          && (decor.banner == null || (decor.banner is string && decor.banner.matches('[a-z-]{1,30}')))
          && (decor.sticker == null || isString(decor.sticker, 1, 16)));
    }

    function validUser(uid) {
      let data = request.resource.data;
      return data.keys().hasOnly(['displayName', 'email', 'photoURL', 'locale', 'profileName', 'showPhoto',
          'photoSource', 'avatar', 'status', 'decor', 'milestones', 'cheer', 'createdAt', 'lastLoginAt'])
        && data.email == myEmail()
        && (!('displayName' in data) || data.displayName == null || isString(data.displayName, 0, 200))
        && (!('profileName' in data) || data.profileName == null || isString(data.profileName, 1, 120))
        && (!('showPhoto' in data) || data.showPhoto is bool)
        && (!('photoSource' in data) || data.photoSource in ['google', 'upload', 'initials'])
        && (!('avatar' in data) || validAvatar(data.avatar, uid))
        && (!('photoURL' in data) || data.photoURL == null || isHttpsUrl(data.photoURL))
        && (!('locale' in data) || data.locale in ['es', 'en'])
        && (!('status' in data) || validStatus(data.status))
        && (!('decor' in data) || validDecor(data.decor))
        && (!('cheer' in data) || data.cheer is bool)
        && (!('milestones' in data) || (data.milestones is map
          && data.milestones.keys().hasOnly(['firstSlide', 'photo', 'firstVote', 'firstEmbed'])));
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid && validUser(uid);
      allow delete: if false;
    }

    // ---------- staffEmails/{email}: the teacher list ----------
    // `get` checks the path, not resource.data: a student reading their own (nonexistent)
    // entry must get "not found", not "permission denied" (PLAN.md review R6).

    match /staffEmails/{email} {
      allow get: if verified() && (email == myEmail() || isAdmin());
      allow list: if isAdmin();
      allow write: if false; // v1: only the admin CLI (Admin SDK) writes here
    }

    // ---------- joinCodes/{code}: invite link → board ----------

    match /joinCodes/{code} {
      allow get: if verified();
      allow list: if false; // codes can't be enumerated
      allow create: if isTeacher()
        && request.resource.data.keys().hasOnly(['boardId', 'boardTitle', 'createdAt'])
        && myEmail() in getAfter(boardPath(request.resource.data.boardId)).data.teacherEmails
        && getAfter(boardPath(request.resource.data.boardId)).data.joinCode == code;
      allow update: if isBoardTeacher(resource.data.boardId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['boardTitle']);
      allow delete: if isBoardTeacher(resource.data.boardId);
    }

    // ---------- boards/{boardId} ----------

    // M12: the board logo, uploaded by its teacher into the board's own folder (see media-api)
    function validBoardLogo(logo, boardId) {
      return logo == null
        || (logo is map
          && logo.keys().hasOnly(['assetId', 'publicId', 'version', 'width', 'height', 'format'])
          && logo.assetId is string
          && logo.publicId is string && logo.publicId.matches('pbl/(dev|prod)/' + boardId + '/board/' + logo.assetId)
          && logo.version is int && logo.width is int && logo.height is int && logo.format is string
          && existsAfter(/databases/$(database)/documents/boards/$(boardId)/assets/$(logo.assetId)));
    }

    // M16: the class clock (keep in sync with ClassClock / MAX_CLOCK_MS in src/model/index.ts)
    function validClock(clock) {
      return clock == null
        || (clock is map
          && clock.keys().hasOnly(['mode', 'label', 'instructions', 'durationMs', 'startedAt', 'elapsedBeforeMs', 'paused'])
          && clock.mode in ['activity', 'break']
          && isString(clock.label, 0, 80) && isString(clock.instructions, 0, 300)
          && clock.durationMs is int && clock.durationMs >= 10000 && clock.durationMs <= 10800000
          && clock.elapsedBeforeMs is int && clock.elapsedBeforeMs >= 0 && clock.elapsedBeforeMs <= clock.durationMs
          && clock.paused is bool
          && clock.startedAt is timestamp);
    }

    // M21: keep in sync with BOARD_STYLES in src/model/index.ts
    function boardStyles() {
      return ['pizarra', 'cuaderno', 'kraft', 'neon', 'minimal', 'retro', 'acuarela', 'blueprint',
        'navidad', 'amigo-secreto', 'halloween', 'verano', 'flores', 'graduacion'];
    }

    function lookDate(value) {
      return value is string && value.matches('[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])');
    }

    function validSchedule(schedule) {
      return schedule == null
        || (schedule is map
          && schedule.keys().hasOnly(['style', 'from', 'to'])
          && schedule.style in boardStyles()
          && lookDate(schedule.from) && lookDate(schedule.to)
          && schedule.from <= schedule.to);
    }

    function validBoard(boardId) {
      let data = request.resource.data;
      return data.keys().hasOnly(['title', 'description', 'teacherEmails', 'joinCode', 'joinCodeEnabled', 'status',
          'archiveAfterDays', 'background', 'createdAt', 'updatedAt', 'lastActivityAt', 'archivedAt', 'stages',
          'pattern', 'layout', 'sortBy', 'stickyHeader', 'logo', 'teacherProfiles', 'clock',
          'style', 'ambient', 'accessories', 'tagline', 'schedule'])
        && isString(data.title, 1, 120)
        && isString(data.description, 0, 500)
        && data.teacherEmails is list && myEmail() in data.teacherEmails
        && data.joinCodeEnabled is bool
        && data.status in ['active', 'locked', 'archived']
        && data.archiveAfterDays is int && data.archiveAfterDays >= 7 && data.archiveAfterDays <= 3650
        // M11: the board's stage list (null = Design Thinking defaults); entries are checked by the app
        && (!('stages' in data) || data.stages == null || (data.stages is list && data.stages.size() >= 1 && data.stages.size() <= 9))
        // M12: look (keep in sync with boardLookSchema in src/model/index.ts)
        && data.background in ['yellow', 'mint', 'sky', 'lavender', 'peach', 'sand', 'white', 'charcoal',
             'sunset', 'ocean', 'forest', 'night']
        && (!('pattern' in data) || data.pattern in ['dots', 'grid', 'none'])
        && (!('layout' in data) || data.layout in ['masonry', 'grid', 'list', 'stages', 'groups'])
        && (!('sortBy' in data) || data.sortBy in ['joined', 'name', 'updated'])
        && (!('stickyHeader' in data) || data.stickyHeader is bool)
        && (!('logo' in data) || validBoardLogo(data.logo, boardId))
        && (!('teacherProfiles' in data) || (data.teacherProfiles is map && data.teacherProfiles.size() <= 10))
        && (!('clock' in data) || validClock(data.clock))
        // M21: board style
        && (!('style' in data) || data.style == null || data.style in boardStyles())
        && (!('ambient' in data) || data.ambient is bool)
        && (!('accessories' in data) || data.accessories is bool)
        && (!('tagline' in data) || isString(data.tagline, 0, 60))
        && (!('schedule' in data) || validSchedule(data.schedule));
    }

    match /boards/{boardId} {
      allow get: if (verified() && myEmail() in resource.data.teacherEmails) || isMember(boardId);
      // The teacher dashboard queries `teacherEmails array-contains <my email>`
      allow list: if verified() && myEmail() in resource.data.teacherEmails;
      allow create: if isTeacher() && validBoard(boardId) && request.resource.data.status == 'active';
      allow update: if (verified() && myEmail() in resource.data.teacherEmails && validBoard(boardId)
          && request.resource.data.joinCode == resource.data.joinCode)
        // members record activity (throttled in the app) while the board is writable
        || (isMember(boardId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastActivityAt'])
          && request.resource.data.lastActivityAt == request.time
          && resource.data.status == 'active'
          && resource.data.lastActivityAt + duration.value(resource.data.archiveAfterDays, 'd') > request.time);
      // Purge (M7): only archived boards, by their teacher; the board doc is deleted last
      allow delete: if verified() && myEmail() in resource.data.teacherEmails
        && resource.data.status == 'archived';

      // ---------- students: one doc per person, 1..n emails ----------

      function validStudent() {
        let data = request.resource.data;
        return data.keys().hasOnly(['displayName', 'emails', 'group', 'status', 'linkedUids', 'source',
            'createdAt', 'joinedAt', 'inviteCode'])
          && isString(data.displayName, 1, 120)
          && validEmails(data.emails)
          && isString(data.group, 0, 60)
          && data.status in ['invited', 'joined']
          && data.linkedUids is list
          && data.source in ['import', 'manual', 'invite'];
      }

      // Invite link: a student not on the list adds themselves, proving they know the board's code
      function joinsWithInvite(boardId) {
        let board = get(boardPath(boardId)).data;
        let data = request.resource.data;
        return verified()
          && board.joinCodeEnabled == true
          && board.status == 'active'
          && board.lastActivityAt + duration.value(board.archiveAfterDays, 'd') > request.time
          && data.source == 'invite'
          && data.inviteCode == board.joinCode
          && data.emails == [myEmail()]
          && data.linkedUids == [request.auth.uid]
          && data.status == 'joined'
          && !exists(studentEmailPath(boardId, myEmail()));
      }

      // Auto-join / second account: the student links their own uid to their own entry
      function linksOwnAccount() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return verified()
          && myEmail() in resource.data.emails
          && changed.hasOnly(['linkedUids', 'status', 'joinedAt'])
          && request.resource.data.status == 'joined'
          && request.resource.data.linkedUids.toSet()
               == resource.data.linkedUids.toSet().union([request.auth.uid].toSet());
      }

      match /students/{studentId} {
        allow get: if isBoardTeacher(boardId) || (verified() && myEmail() in resource.data.emails);
        allow list: if isBoardTeacher(boardId);
        allow create: if validStudent() && (isBoardTeacher(boardId) || joinsWithInvite(boardId));
        allow update: if validStudent() && (isBoardTeacher(boardId) || linksOwnAccount());
        allow delete: if isBoardTeacher(boardId);
      }

      // ---------- studentEmails/{email}: email → studentId (lookup index) ----------

      function validStudentEmail(email) {
        let data = request.resource.data;
        return data.keys().hasOnly(['email', 'studentId']) && data.email == email && data.studentId is string;
      }

      match /studentEmails/{email} {
        allow get: if isBoardTeacher(boardId) || (verified() && email == myEmail());
        allow list: if isBoardTeacher(boardId);
        allow create: if validStudentEmail(email) && (
          isBoardTeacher(boardId)
          // invite batch: my own email, pointing to the student I'm creating in this same batch
          // (a NEW student whose only email and account are mine: never someone else's entry)
          || (verified() && email == myEmail()
              && !exists(studentPath(boardId, request.resource.data.studentId))
              && getAfter(studentPath(boardId, request.resource.data.studentId)).data.source == 'invite'
              && getAfter(studentPath(boardId, request.resource.data.studentId)).data.emails == [myEmail()]
              && getAfter(studentPath(boardId, request.resource.data.studentId)).data.linkedUids == [request.auth.uid]
              && getAfter(memberPath(boardId, request.auth.uid)).data.studentId == request.resource.data.studentId)
        );
        allow update: if validStudentEmail(email) && isBoardTeacher(boardId);
        allow delete: if isBoardTeacher(boardId);
      }

      // ---------- members/{uid}: a login account linked to a student ----------

      match /members/{uid} {
        allow get: if isBoardTeacher(boardId) || (signedIn() && request.auth.uid == uid);
        allow list: if isBoardTeacher(boardId);
        // The email index (existing, or created in the same invite batch) must point to this student
        allow create: if verified() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['uid', 'studentId', 'email', 'joinedAt'])
          && request.resource.data.uid == uid
          && request.resource.data.email == myEmail()
          && getAfter(studentEmailPath(boardId, myEmail())).data.studentId == request.resource.data.studentId;
        allow update: if isBoardTeacher(boardId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['studentId']);
        allow delete: if isBoardTeacher(boardId) || (signedIn() && request.auth.uid == uid);
      }

      // ---------- spaces/{studentId}: what the dashboard card shows ----------

      // Keep in sync with SPACE_COLORS in src/model/index.ts
      function spaceColors() {
        return ['#FFFFFF', '#FEF3C7', '#FCE7F3', '#EDE9FE', '#DBEAFE', '#DCFCE7', '#FFEDD5'];
      }

      // Cloudinary public id of an image uploaded for this student (see media-api uploadParams)
      function studentPublicId(boardId, studentId, assetId) {
        return 'pbl/(dev|prod)/' + boardId + '/' + studentId + '/' + assetId;
      }

      function validImageRef(ref, boardId, studentId) {
        return ref is map
          && ref.keys().hasOnly(['assetId', 'publicId', 'version', 'width', 'height', 'format'])
          && ref.assetId is string
          && ref.publicId is string && ref.publicId.matches(studentPublicId(boardId, studentId, ref.assetId))
          && ref.version is int && ref.width is int && ref.height is int
          && ref.format is string
          // must be a registered upload (written just before, or in the same batch)
          && existsAfter(/databases/$(database)/documents/boards/$(boardId)/assets/$(ref.assetId));
      }

      function validSpace(studentId) {
        let data = request.resource.data;
        return data.keys().hasOnly(['studentId', 'ownerName', 'ownerPhotoURL', 'title', 'summary', 'color',
            'slideOrder', 'slideCount', 'cover', 'stage', 'stageUpdatedAt', 'stageSetBy', 'group', 'teacherEditsUnseen',
            'readyToPresent', 'readyAt', 'ownerStatus', 'ownerDecor', 'createdAt', 'updatedAt'])
          && (!('cover' in data) || data.cover == null || validImageRef(data.cover, boardId, studentId))
          && data.studentId == studentId
          && isString(data.ownerName, 1, 120)
          && (data.ownerPhotoURL == null || isHttpsUrl(data.ownerPhotoURL))
          && isString(data.title, 0, 120)
          && isString(data.summary, 0, 1000)
          && data.color in spaceColors()
          && data.slideOrder is list && data.slideOrder.size() <= 50
          && data.slideCount == data.slideOrder.size()
          // M11: a stage id (same pattern as STAGE_ID_PATTERN), or null for no ring
          && (!('stage' in data) || data.stage == null || (data.stage is string && data.stage.matches('[a-z0-9-]{1,40}')))
          && (!('stageSetBy' in data) || data.stageSetBy in ['student', 'teacher'])
          && (!('group' in data) || isString(data.group, 0, 60))
          && (!('teacherEditsUnseen' in data) || data.teacherEditsUnseen is bool)
          && (!('readyToPresent' in data) || data.readyToPresent is bool)
          && (!('ownerStatus' in data) || validStatus(data.ownerStatus))
          && (!('ownerDecor' in data) || validDecor(data.ownerDecor));
      }

      // M11: whoever changes the stage signs it, with the server time
      function stageSignedBy(who) {
        return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['stage', 'stageUpdatedAt', 'stageSetBy'])
          || (request.resource.data.stageSetBy == who && request.resource.data.stageUpdatedAt == request.time);
      }

      function isSpaceOwner(boardId, studentId) {
        return isMember(boardId) && get(memberPath(boardId, request.auth.uid)).data.studentId == studentId;
      }

      // Same as isWritable() in src/features/boards/lifecycle.ts: active and not auto-archived
      function boardIsActive(boardId) {
        let board = get(boardPath(boardId)).data;
        return board.status == 'active'
          && board.lastActivityAt + duration.value(board.archiveAfterDays, 'd') > request.time;
      }

      match /spaces/{studentId} {
        allow read: if isBoardTeacher(boardId) || isMember(boardId);
        allow create: if validSpace(studentId) && (
          // the teacher (e.g. merging two students keeps the content)
          isBoardTeacher(boardId)
          // the student when joining: their own, empty space
          || (getAfter(memberPath(boardId, request.auth.uid)).data.studentId == studentId
              && request.resource.data.title == '' && request.resource.data.summary == ''
              && request.resource.data.slideOrder == [] && request.resource.data.slideCount == 0)
        );
        allow update: if validSpace(studentId) && (
          // the student edits their card and the order of their slides (and their name, from /me)
          (isSpaceOwner(boardId, studentId) && boardIsActive(boardId)
            && request.resource.data.updatedAt == request.time
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['title', 'summary', 'color', 'ownerName', 'ownerPhotoURL', 'cover', 'slideOrder',
                   'slideCount', 'stage', 'stageUpdatedAt', 'stageSetBy', 'readyToPresent', 'readyAt',
                   'ownerStatus', 'ownerDecor', 'updatedAt'])
            && stageSignedBy('student'))
          // the teacher renames the student or changes their group → keep the card in sync (M12)
          || (isBoardTeacher(boardId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerName', 'group']))
          // M21: the teacher clears a student's profile message on their board (moderation)
          || (isBoardTeacher(boardId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerStatus'])
            && request.resource.data.ownerStatus == null)
          // M15: the student has seen the teacher's changes (no "updated" bump)
          || (isSpaceOwner(boardId, studentId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['teacherEditsUnseen'])
            && request.resource.data.teacherEditsUnseen == false)
          // M15: the teacher changed a slide (badge on the card), or appended a slide at the end
          || (isBoardTeacher(boardId) && boardIsActive(boardId)
            && request.resource.data.teacherEditsUnseen == true
            && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['teacherEditsUnseen'])
              || (request.resource.data.diff(resource.data).affectedKeys()
                    .hasOnly(['slideOrder', 'slideCount', 'teacherEditsUnseen'])
                && request.resource.data.slideOrder.size() == resource.data.slideOrder.size() + 1
                && request.resource.data.slideOrder[0:resource.data.slideOrder.size()] == resource.data.slideOrder)))
          // the teacher sets a student's stage (M11), while the board is writable
          || (isBoardTeacher(boardId) && boardIsActive(boardId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stage', 'stageUpdatedAt', 'stageSetBy'])
            && stageSignedBy('teacher'))
        );
        allow delete: if isBoardTeacher(boardId);

        // ---------- slides/{slideId}: one Excalidraw scene per slide (M5) ----------
        // Saving a slide never touches the space document (dashboards listen to spaces).
        // Rules can't loop over `files`, so each image ref isn't checked like the cover is;
        // the M7 cleanup only trusts the asset registry (folder + studentId) before deleting.

        function validSlide() {
          let data = request.resource.data;
          return data.keys().hasOnly(['engine', 'content', 'files', 'assetIds', 'bytes', 'schemaVersion', 'updatedAt',
              'lastEditedBy', 'teacherEditedAt', 'versionAssetIds'])
            && data.engine == 'excalidraw'
            && data.content is string && data.content.size() <= 900000
            && data.files is map && data.files.size() <= 30
            && data.assetIds is list && data.assetIds.size() <= data.files.size()
            && data.bytes is int && data.bytes >= 0 && data.bytes <= 900000
            && data.schemaVersion == 1
            && data.updatedAt == request.time
            // M15: who saved last; the images of the kept versions
            && (!('lastEditedBy' in data) || data.lastEditedBy in ['student', 'teacher'])
            && (!('versionAssetIds' in data) || (data.versionAssetIds is list && data.versionAssetIds.size() <= 60));
        }

        // M15: a teacher's save is signed with the server time; a student's never claims to be the teacher's
        function savedBy(who) {
          return who == 'teacher'
            ? request.resource.data.lastEditedBy == 'teacher' && request.resource.data.teacherEditedAt == request.time
            : !('lastEditedBy' in request.resource.data) || request.resource.data.lastEditedBy == 'student';
        }

        match /slides/{slideId} {
          allow read: if isBoardTeacher(boardId) || isMember(boardId);
          // A new slide must be listed in the space's slide order (same batch)
          allow create: if validSlide()
            && ((isSpaceOwner(boardId, studentId) && boardIsActive(boardId))
              // the teacher restoring a backup into a new board (M7)
              || isBoardTeacher(boardId))
            && slideId in getAfter(/databases/$(database)/documents/boards/$(boardId)/spaces/$(studentId)).data.slideOrder;
          allow update: if validSlide() && boardIsActive(boardId)
            && ((isSpaceOwner(boardId, studentId) && savedBy('student'))
              // M15: the board's teacher improves a student's slide
              || (isBoardTeacher(boardId) && savedBy('teacher')));
          allow delete: if isBoardTeacher(boardId)
            || (isSpaceOwner(boardId, studentId) && boardIsActive(boardId));
        }

        // ---------- M15: kept versions of a slide and who is editing it ----------

        function validVersion(kind) {
          let data = request.resource.data;
          return data.keys().hasOnly(['content', 'files', 'assetIds', 'bytes', 'kind', 'createdAt'])
            && data.kind == kind
            && data.content is string && data.content.size() <= 900000
            && data.files is map && data.files.size() <= 30
            && data.assetIds is list && data.assetIds.size() <= 30
            && data.bytes is int && data.bytes >= 0 && data.bytes <= 900000
            && data.createdAt == request.time;
        }

        match /slides/{slideId}/versions/{kind} {
          allow read: if isBoardTeacher(boardId) || isSpaceOwner(boardId, studentId);
          // the teacher keeps the student's version; the student swaps versions when restoring
          allow create, update: if kind in ['student', 'teacher'] && validVersion(kind) && boardIsActive(boardId)
            && ((isBoardTeacher(boardId) && kind == 'student') || isSpaceOwner(boardId, studentId));
          allow delete: if isBoardTeacher(boardId) || isSpaceOwner(boardId, studentId);
        }

        function freeOrMine() {
          return resource == null || resource.data.uid == request.auth.uid
            || resource.data.at < request.time - duration.value(60, 's');
        }

        match /locks/{slideId} {
          allow read: if isBoardTeacher(boardId) || isSpaceOwner(boardId, studentId);
          allow create, update: if boardIsActive(boardId) && freeOrMine()
            && request.resource.data.keys().hasOnly(['uid', 'name', 'role', 'at'])
            && request.resource.data.uid == request.auth.uid
            && isString(request.resource.data.name, 1, 200)
            && request.resource.data.at == request.time
            && ((request.resource.data.role == 'teacher' && isBoardTeacher(boardId))
              || (request.resource.data.role == 'student' && isSpaceOwner(boardId, studentId)));
          // the teacher may always clear one (e.g. purge); the student their own or a stale one
          allow delete: if isBoardTeacher(boardId) || (isSpaceOwner(boardId, studentId) && freeOrMine());
        }

        // ---------- M16: polls in a student's space, one vote per student ----------

        function pollPath(pollId) {
          return /databases/$(database)/documents/boards/$(boardId)/spaces/$(studentId)/polls/$(pollId);
        }

        function votePath(pollId, voterId) {
          return /databases/$(database)/documents/boards/$(boardId)/spaces/$(studentId)/polls/$(pollId)/votes/$(voterId);
        }

        function myStudentId() {
          return get(memberPath(boardId, request.auth.uid)).data.studentId;
        }

        function validNewPoll() {
          let data = request.resource.data;
          return data.keys().hasOnly(['question', 'options', 'optionIds', 'counts', 'anonymous', 'status', 'authorUid',
              'authorName', 'authorRole', 'createdAt'])
            && isString(data.question, 1, 200)
            && data.options is list && data.options.size() >= 2 && data.options.size() <= 6
            && data.optionIds is list && data.optionIds.size() == data.options.size()
            && data.counts == {}
            && data.anonymous is bool
            && data.status == 'open'
            && data.authorUid == request.auth.uid
            && isString(data.authorName, 1, 200)
            && data.createdAt == request.time;
        }

        // A vote moves the counts by exactly one (a change of vote: one down, one up), in the same batch
        function countsFollowVote(pollId, voterId) {
          let before = resource.data.counts;
          let after = request.resource.data.counts;
          let next = getAfter(votePath(pollId, voterId)).data.optionId;
          return after.get(next, 0) == before.get(next, 0) + 1
            && (exists(votePath(pollId, voterId))
              ? (get(votePath(pollId, voterId)).data.optionId != next
                && after.get(get(votePath(pollId, voterId)).data.optionId, 0)
                     == before.get(get(votePath(pollId, voterId)).data.optionId, 0) - 1
                && after.diff(before).affectedKeys()
                     .hasOnly([next, get(votePath(pollId, voterId)).data.optionId]))
              : after.diff(before).affectedKeys().hasOnly([next]));
        }

        match /polls/{pollId} {
          allow read: if isBoardTeacher(boardId) || isMember(boardId);
          allow create: if boardIsActive(boardId) && validNewPoll()
            && ((isSpaceOwner(boardId, studentId) && request.resource.data.authorRole == 'student')
              || (isBoardTeacher(boardId) && request.resource.data.authorRole == 'teacher'));
          allow update: if boardIsActive(boardId) && (
            // the author or the teacher opens / closes it
            ((isBoardTeacher(boardId) || resource.data.authorUid == request.auth.uid)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
              && request.resource.data.status in ['open', 'closed'])
            // a student votes: the counts follow their vote
            || (isMember(boardId) && resource.data.status == 'open'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['counts'])
              && countsFollowVote(pollId, myStudentId())));
          allow delete: if isBoardTeacher(boardId) || resource.data.authorUid == request.auth.uid;

          match /votes/{voterId} {
            // Who voted: the teacher; the author too unless the poll is anonymous; each student their own
            allow get: if isBoardTeacher(boardId)
              || (isMember(boardId) && voterId == myStudentId())
              || (get(pollPath(pollId)).data.authorUid == request.auth.uid && get(pollPath(pollId)).data.anonymous == false);
            allow list: if isBoardTeacher(boardId)
              || (get(pollPath(pollId)).data.authorUid == request.auth.uid && get(pollPath(pollId)).data.anonymous == false);
            allow create, update: if isMember(boardId) && boardIsActive(boardId)
              && voterId == myStudentId()
              && get(pollPath(pollId)).data.status == 'open'
              && request.resource.data.keys().hasOnly(['optionId', 'votedAt'])
              && request.resource.data.optionId in get(pollPath(pollId)).data.optionIds
              && request.resource.data.votedAt == request.time
              && getAfter(pollPath(pollId)).data.counts != get(pollPath(pollId)).data.counts;
            // with the poll (same batch), or by the teacher (student removed, purge)
            allow delete: if isBoardTeacher(boardId)
              || (get(pollPath(pollId)).data.authorUid == request.auth.uid && !existsAfter(pollPath(pollId)));
          }
        }

        // ---------- notes/{noteId}: the teacher's annotations on a slide ----------
        // Private feedback: the board's teachers and the space's owner, never classmates.

        function slidePath(boardId, studentId, slideId) {
          return /databases/$(database)/documents/boards/$(boardId)/spaces/$(studentId)/slides/$(slideId);
        }

        match /notes/{noteId} {
          allow read: if isBoardTeacher(boardId) || isSpaceOwner(boardId, studentId);
          allow create: if isBoardTeacher(boardId)
            && request.resource.data.keys().hasOnly(['slideId', 'text', 'authorEmail', 'authorName',
                'createdAt', 'updatedAt'])
            && request.resource.data.slideId is string
            && exists(slidePath(boardId, studentId, request.resource.data.slideId))
            && isString(request.resource.data.text, 1, 2000)
            && request.resource.data.authorEmail == myEmail()
            && isString(request.resource.data.authorName, 1, 200)
            && request.resource.data.createdAt == request.time
            && request.resource.data.updatedAt == request.time;
          allow update: if isBoardTeacher(boardId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'updatedAt'])
            && isString(request.resource.data.text, 1, 2000)
            && request.resource.data.updatedAt == request.time;
          // The owner removes them only together with their slide (same batch)
          allow delete: if isBoardTeacher(boardId)
            || (isSpaceOwner(boardId, studentId)
              && !existsAfter(slidePath(boardId, studentId, resource.data.slideId)));
        }
      }

      // ---------- announcements (M19): the teacher announces, members read ----------

      // Keep in sync with announcementInputSchema in src/model/index.ts
      function validAnnouncement() {
        let data = request.resource.data;
        return data.keys().hasOnly(['title', 'body', 'link', 'important', 'authorEmail', 'authorName',
            'createdAt', 'updatedAt', 'remindedAt'])
          && isString(data.title, 1, 80)
          && isString(data.body, 0, 500)
          && isString(data.link, 0, 500)
          && (data.link == '' || data.link.matches('https://[^ ]+') || data.link.matches('/[^ ]*'))
          && data.important is bool
          && data.authorEmail == myEmail()
          && isString(data.authorName, 1, 200)
          && data.createdAt is timestamp
          && data.updatedAt == request.time;
      }

      match /announcements/{announcementId} {
        allow read: if isBoardTeacher(boardId) || isMember(boardId);
        allow create: if isBoardTeacher(boardId) && validAnnouncement()
          && request.resource.data.createdAt == request.time
          && request.resource.data.remindedAt == request.time;
        // Edit keeps the dates; "Recordar" moves remindedAt to now
        allow update: if isBoardTeacher(boardId) && validAnnouncement()
          && request.resource.data.createdAt == resource.data.createdAt
          && (request.resource.data.remindedAt == resource.data.remindedAt
            || request.resource.data.remindedAt == request.time);
        allow delete: if isBoardTeacher(boardId);
      }

      // Each member's own read / removed state; the teacher reads them all (read counts)
      match /announcementState/{uid} {
        allow get: if isBoardTeacher(boardId) || (isMember(boardId) && request.auth.uid == uid);
        allow list: if isBoardTeacher(boardId);
        allow create, update: if isMember(boardId) && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['read', 'removed', 'updatedAt'])
          && request.resource.data.read is map && request.resource.data.read.size() <= 200
          && request.resource.data.removed is map && request.resource.data.removed.size() <= 200
          && request.resource.data.updatedAt == request.time;
        allow delete: if isBoardTeacher(boardId) || (signedIn() && request.auth.uid == uid);
      }

      // ---------- attendance (M18): one record per class date, teacher only ----------

      // Keep the date pattern in sync with ATTENDANCE_DATE in src/model/index.ts
      function validAttendance(date) {
        let data = request.resource.data;
        return data.keys().hasOnly(['date', 'topic', 'marks', 'takenBy', 'updatedAt'])
          && date.matches('[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])')
          && data.date == date
          && isString(data.topic, 0, 120)
          && data.marks is map && data.marks.size() <= 500
          && data.takenBy == myEmail()
          && data.updatedAt == request.time;
      }

      match /attendance/{date} {
        allow read, delete: if isBoardTeacher(boardId);
        allow create, update: if isBoardTeacher(boardId) && validAttendance(date);
      }

      // Each student's own summary (dates and states, never the teacher's notes): the student reads it
      match /attendanceByStudent/{studentId} {
        allow get: if isBoardTeacher(boardId) || isSpaceOwner(boardId, studentId);
        allow list, delete: if isBoardTeacher(boardId);
        allow create, update: if isBoardTeacher(boardId)
          && request.resource.data.keys().hasOnly(['dates', 'updatedAt'])
          && request.resource.data.dates is map && request.resource.data.dates.size() <= 400
          && request.resource.data.updatedAt == request.time;
      }

      // ---------- assets/{assetId}: registry of every upload (storage usage, cleanup in M7) ----------

      function validNewAsset(boardId, assetId) {
        let data = request.resource.data;
        return data.keys().hasOnly(['publicId', 'studentId', 'kind', 'width', 'height', 'format', 'bytes', 'status', 'createdAt'])
          && data.studentId is string
          && data.publicId is string && data.publicId.matches(studentPublicId(boardId, data.studentId, assetId))
          && data.kind in ['cover', 'slide', 'logo']
          && data.width is int && data.height is int && data.format is string
          && data.bytes is int && data.bytes > 0 && data.bytes <= 10 * 1024 * 1024
          && data.status == 'active'
          && data.createdAt == request.time;
      }

      match /assets/{assetId} {
        allow read: if isBoardTeacher(boardId)
          || (isMember(boardId) && resource.data.studentId == get(memberPath(boardId, request.auth.uid)).data.studentId);
        allow create: if validNewAsset(boardId, assetId) && boardIsActive(boardId)
          && (
            (isSpaceOwner(boardId, request.resource.data.studentId) && request.resource.data.kind != 'logo')
            // M15: an image the teacher adds to a student's slide (the student's folder)
            || (isBoardTeacher(boardId) && request.resource.data.kind == 'slide'
              && exists(/databases/$(database)/documents/boards/$(boardId)/spaces/$(request.resource.data.studentId)))
            // M12: the board logo, by the board's teacher, in the board's own folder
            || (isBoardTeacher(boardId) && request.resource.data.kind == 'logo'
              && request.resource.data.studentId == 'board')
          );
        // The owner marks an image unused; the teacher (via cleanup, M7) may also mark it deleted
        allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'deletedAt'])
          && (
            (isSpaceOwner(boardId, resource.data.studentId) && request.resource.data.status in ['active', 'orphaned'])
            || (isBoardTeacher(boardId) && request.resource.data.status in ['active', 'orphaned', 'deleted'])
          );
        // Purge (M7): the registry goes with the archived board
        allow delete: if isBoardTeacher(boardId) && get(boardPath(boardId)).data.status == 'archived';
      }
    }

    // ---------- collection-group queries (auto-join, "my boards") ----------

    match /{path=**}/studentEmails/{email} {
      allow list: if verified() && resource.data.email == myEmail();
    }

    match /{path=**}/members/{uid} {
      allow list: if signedIn() && resource.data.uid == request.auth.uid;
    }
  }
}
