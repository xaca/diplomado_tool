{
  "name": "media-api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "start": "wrangler dev",
    "test": "vitest",
    "cf-typegen": "wrangler types --strict-vars=false",
    "dev:emulators": "wrangler dev --var AUTH_MODE:emulator --var FIREBASE_PROJECT_ID:demo-pbl --var FIRESTORE_HOST:http://127.0.0.1:8080",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.3",
    "@types/node": "^26.6.5",
    "typescript": "^5.5.2",
    "vitest": "~5.0.3",
    "wrangler": "^4.153.0"
  },
  "dependencies": {
    "jose": "^6.2.13"
  }
}
