# Local emulator mode (`npm run dev:emulators`). Fake values: "demo-*" projects only exist
# in the Firebase emulators, so this mode can never touch production data.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-pbl.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-pbl
VITE_FIREBASE_STORAGE_BUCKET=demo-pbl.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
VITE_CLOUDINARY_CLOUD_NAME=syqkgwws
VITE_MEDIA_API_URL=http://localhost:8787
VITE_USE_EMULATORS=true
