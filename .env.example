# Copy to .env.local and fill in from Firebase console → Project settings → Your apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloudinary (public cloud name only — the API secret lives in the media-api Worker)
VITE_CLOUDINARY_CLOUD_NAME=

# media-api Cloudflare Worker (local: http://localhost:8787)
VITE_MEDIA_API_URL=

# App Check (reCAPTCHA v3 site key, public). Leave empty until it's registered in Firebase → App Check.
VITE_RECAPTCHA_SITE_KEY=
# Local dev with App Check: paste the debug token you registered (Firebase → App Check → Manage debug tokens)
VITE_APPCHECK_DEBUG_TOKEN=

# true = use local Firebase emulators in dev (run `npm run emulators`)
VITE_USE_EMULATORS=false
