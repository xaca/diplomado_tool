# Copy to .env.local and fill in from Firebase console → Project settings → Your apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloudinary (public cloud name only — the API secret lives in the media-api Worker)
VITE_CLOUDINARY_CLOUD_NAME=

# media-api Cloudflare Worker (local: http://localhost:8787)
VITE_MEDIA_API_URL=

# true = use local Firebase emulators in dev (run `npm run emulators`)
VITE_USE_EMULATORS=false
