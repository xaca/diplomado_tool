{
  "name": "diplomado_pbl",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "format": "prettier --write .",
    "typecheck": "tsc -b",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-pbl",
    "deploy": "npm run build && firebase deploy",
    "admin": "tsx scripts/admin/index.ts",
    "test:rules": "firebase emulators:exec --only firestore --project demo-pbl \"vitest run --project rules\"",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes",
    "dev:emulators": "vite --mode emulators",
    "seed": "tsx scripts/seed.ts",
    "test": "vitest run --project unit",
    "test:e2e": "firebase emulators:exec --only auth,firestore --project demo-pbl \"playwright test\"",
    "check": "npm run typecheck && npm run lint && prettier --check . && npm test && npm run test:worker && npm run test:rules && npm run test:e2e && npm run test:worker-integration && npm run build",
    "emulators:free": "tsx scripts/free-emulator-ports.ts",
    "pretest:rules": "npm run emulators:free",
    "pretest:e2e": "npm run emulators:free",
    "preemulators": "npm run emulators:free",
    "test:worker-integration": "firebase emulators:exec --only auth,firestore --project demo-pbl \"tsx tests/integration/worker.ts\"",
    "pretest:worker-integration": "npm run emulators:free",
    "test:worker": "npm --prefix services/media-api run typecheck && npm --prefix services/media-api run test -- --run",
    "worker:dev": "npm --prefix services/media-api run dev",
    "worker:dev:emulators": "npm --prefix services/media-api run dev:emulators",
    "worker:deploy": "npm --prefix services/media-api run deploy"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "firebase": "^13.1.0",
    "gsap": "^3.15.0",
    "i18next": "^26.5.11",
    "i18next-browser-languagedetector": "^8.2.3",
    "lucide-react": "^1.61.0",
    "nanoid": "^6.0.2",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.9",
    "react-router": "^7.18.4",
    "shadcn": "^4.22.1",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "commander": "^15.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "firebase-admin": "^14.5.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@firebase/rules-unit-testing": {
      "firebase": "$firebase"
    }
  }
}
